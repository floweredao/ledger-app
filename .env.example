# Bind address. Only loopback is accepted: 127.0.0.1, localhost or ::1.
LEDGER_HOST=127.0.0.1
LEDGER_PORT=4340
# SQLite database, credentials.json (owner_token, mode 0600) and backups live here.
LEDGER_DATA_DIR=./data
# Built client served by the API server (resolved against the working directory).
LEDGER_STATIC_DIR=./dist
# Tailscale Serve host (host[:port], no scheme) and the tailnet login allowed to bootstrap a session.
LEDGER_TAILSCALE_HOST=
LEDGER_TAILSCALE_LOGIN=
# Extra allowed Origins, comma separated. http://127.0.0.1:<port>, http://localhost:<port>,
# the Vite dev origins on 4341 and https://<LEDGER_TAILSCALE_HOST> are always allowed.
LEDGER_ALLOWED_ORIGINS=
# Read-only source module for the KakaoBank importer and its polling interval.
# Defaults to ~/.local/share/ddolmeng-mode/bin/ledger.ts for the running user.
# LEDGER_MODULE=/absolute/path/to/read-only-ledger.ts
LEDGER_IMPORT_INTERVAL_MS=60000
